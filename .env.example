# Settings the app reads from environment variables.
# The app does not load this file by itself: set these in your shell for local runs
# (PowerShell: $env:NAME="value") and in Render's Environment tab for the live site.
# Never commit real values.

# Which data folder to serve: deploy_data (default for run.py and on Render) or data (full local dataset)
DATA_DIR=deploy_data

# Signs login sessions. Without it a temporary key is used and sessions reset on restart.
SECRET_KEY=change-me-to-a-long-random-string

# Accounts database. Leave unset locally to use instance/accounts.db (SQLite).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SQLITE_PATH=instance/accounts.db

# Password-reset email through Brevo (optional)
# BREVO_API_KEY=your-brevo-api-key
# MAIL_SENDER=verified-sender@gmail.com
# MAIL_SENDER_NAME=NEPSE Intelligence

# Google sign-in (optional; the button stays disabled until both are set)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
